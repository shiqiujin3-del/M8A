{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "External Action Queue V1",
  "type": "object",
  "required": [
    "version",
    "generated_at",
    "status_enum",
    "actions"
  ],
  "properties": {
    "version": {
      "type": "string"
    },
    "generated_at": {
      "type": "string"
    },
    "status_enum": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "actions": {
      "type": "array",
      "items": {
        "type": "object"
      }
    }
  }
}
