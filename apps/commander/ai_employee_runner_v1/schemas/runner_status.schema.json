{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "AI Employee Runner Status V1",
  "type": "object",
  "required": [
    "employee_id",
    "status",
    "current_task",
    "updated_at"
  ],
  "properties": {
    "employee_id": {
      "type": "string"
    },
    "status": {
      "type": "string",
      "enum": [
        "idle",
        "assigned",
        "running",
        "waiting_dependency",
        "waiting_qa",
        "waiting_ceo",
        "completed",
        "failed",
        "blocked",
        "retrying"
      ]
    },
    "current_task": {
      "type": "string"
    },
    "updated_at": {
      "type": "string"
    }
  }
}
