{
  "version": "ai_employee_center_v2",
  "name": "M8A AI Employee Organization V2",
  "principle": "以后 M8A 建设以 AI Employee 为核心，不再以 Runtime、JSON、Contract、Provider 为主要目标。",
  "governance": {
    "ceo": {
      "role": "最终决策人",
      "responsibilities": [
        "设定业务目标",
        "审批高风险外部动作",
        "确认平台授权",
        "验收员工产出"
      ]
    },
    "commander": {
      "role": "总调度",
      "responsibilities": [
        "接收 CEO Mission",
        "拆分任务",
        "分配 AI Employee",
        "检查依赖",
        "调度 Runtime Core 与 Provider Interface",
        "汇总结果给 CEO"
      ],
      "rule": "所有员工最终由 Commander 调度；员工不得绕过 Commander 自行接生产平台。"
    }
  },
  "departments": [
    {
      "department_id": "content_growth",
      "name": "内容增长部",
      "employees": [
        "content_employee",
        "seo_employee",
        "geo_employee",
        "website_employee",
        "video_employee",
        "publishing_employee",
        "marketing_employee"
      ]
    },
    {
      "department_id": "knowledge_data",
      "name": "知识与数据部",
      "employees": [
        "knowledge_employee",
        "knowledge_qa_employee",
        "analytics_employee",
        "data_employee",
        "documentation_employee"
      ]
    },
    {
      "department_id": "customer_revenue",
      "name": "客户与营收部",
      "employees": [
        "sales_employee",
        "crm_employee",
        "customer_success_employee"
      ]
    },
    {
      "department_id": "operations_control",
      "name": "运营与控制部",
      "employees": [
        "automation_employee",
        "system_maintenance_employee",
        "security_employee",
        "finance_employee",
        "recruiting_employee"
      ]
    }
  ],
  "employees": [
    {
      "employee_id": "publishing_employee",
      "name": "Publishing Employee",
      "reports_to": "commander",
      "responsibility": "统一接收发布类 Mission，协调内容、审批、Publishing Center 与 Provider，确保只在授权范围内发布或创建草稿。",
      "when_to_work": "当 Mission 类型为 publish_article、publish_product、publish_video、publish_social_post、draft_only_handoff 时启动。",
      "mission_types": [
        "publish_article",
        "publish_product",
        "publish_video",
        "publish_social_post",
        "draft_only_handoff"
      ],
      "providers": [
        "Publishing Center",
        "WordPress Provider",
        "YouTube Provider",
        "Gmail Draft Provider"
      ],
      "outputs": [
        "Publishing Plan",
        "Draft-only Handoff",
        "Publishing Result",
        "Approval Request",
        "Execution Summary"
      ],
      "status": "next_recommended_employee"
    },
    {
      "employee_id": "content_employee",
      "name": "Content Employee",
      "reports_to": "commander",
      "responsibility": "生成客户可读内容、产品文章、博客、社媒文案、邮件正文草稿。",
      "when_to_work": "当 Mission 需要文字内容、销售回复、产品介绍、脚本草稿时启动。",
      "mission_types": [
        "content_draft",
        "product_article",
        "blog_article",
        "sales_reply",
        "video_script"
      ],
      "providers": [
        "Knowledge Center",
        "Prompt System",
        "Local Draft Generator"
